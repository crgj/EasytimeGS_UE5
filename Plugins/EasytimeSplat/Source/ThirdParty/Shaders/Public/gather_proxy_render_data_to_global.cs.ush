[numthreads(THREAD_GROUP_SIZE_X, 1, 1)] void main(
    uint3 dispatch_thread_id : SV_DispatchThreadID) {
  uint local_id = dispatch_thread_id.x;
  if (local_id >= num_splats) {
    return;
  }

  uint global_id = global_offset + local_id;
  float4 pos_local = unpack_pos(positions[local_id], pos_scale_cm, pos_min_cm);
  float4 pos_world = mul(pos_local, local_to_world);
  float4 pos_clip = mul(pos_local, local_to_clip);

  // WDD-2026-04-06-GlobalDepth32-UpgradeComment:GlobalSortStep4-v2
  // Build global sortable key directly from clip depth with 32-bit precision.
  uint depth_key = uint(saturate(pos_clip.z / max(pos_clip.w, 1e-8f)) * 4294967294.0f);
  out_global_indices[global_id] = global_id;
  out_global_distances[global_id] = depth_key;

  out_global_world_centers[global_id] = pos_world;
  out_global_transforms[global_id] = transforms[local_id];

  float4 c = colors[local_id];
  c.a *= opacity;
  out_global_colors[global_id] = c;
}
