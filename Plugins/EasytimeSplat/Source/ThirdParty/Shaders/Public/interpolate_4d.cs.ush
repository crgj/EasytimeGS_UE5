Buffer<float3> xyz_bank;
Buffer<float4> rot_bank;
Buffer<float3> dc_bank;
Buffer<float2> lifetime_mu_w;
Buffer<float3> scales;
Buffer<float4> base_colors;

float current_frame;
uint num_xyz_banks;
uint num_rot_banks;
uint num_dc_banks;
uint xyz_stride;
uint rot_stride;
uint dc_stride;
uint num_splats;
float3 pos_scale_cm;
float3 pos_min_cm;

RWBuffer<uint> out_positions;
RWBuffer<uint2> out_covariances;
RWBuffer<float4> out_colors;

// Simple packing for UNorm
uint to_unorm(float f, uint bits) {
    uint max_val = (1u << bits) - 1u;
    return uint(saturate(f) * float(max_val) + 0.5f);
}

float3 dc_to_linear_rgb(float3 dc) {
    float3 color_srgb = 0.5f + 0.2820948f * dc;
    return saturate(pow(max(color_srgb, 0.0f), 2.2f));
}

// Float to custom 5e5/5e6 format (simplified for GPU)
uint to_custom_float(float f, uint signed_bits, uint exp_bits, uint sig_bits) {
    // This is a simplified version of ToFloat from PackedTypes.h
    // For variances/orientations, we just need enough precision
    if (f == 0.0f) return 0;
    
    uint raw = asuint(f);
    uint sign = (raw >> 31) & signed_bits;
    int exponent = int((raw >> 23) & 0xFF) - 127;
    uint mantissa = raw & 0x7FFFFF;
    
    int bias = (1 << (exp_bits - 1)) - 1;
    exponent = clamp(exponent, -bias + 1, bias);
    uint e_packed = uint(exponent + bias) << sig_bits;
    uint m_packed = mantissa >> (23 - sig_bits);
    
    if (signed_bits > 0) {
        return (sign << (exp_bits + sig_bits)) | (e_packed & ((1u << (exp_bits + sig_bits)) - 1u)) | m_packed; 
    }
    return e_packed | m_packed;
}

[numthreads(THREAD_GROUP_SIZE_X, 1, 1)]
void main(uint3 dispatch_thread_id : SV_DispatchThreadID) {
    uint i = dispatch_thread_id.x;
    if (i >= num_splats) return;

    // 1. Lifetime gating
    // lifetime_mu_w stores (mu, w). Keep splat visible inside [mu - w, mu + w]
    // with smooth edges; if w is invalid, fall back to fully visible.
    float2 mu_w = lifetime_mu_w[i];
    float mu = mu_w.x;
    float w = mu_w.y;
    float opacity_multiplier = 1.0f;
    if (w > 1e-6f)
    {
        const float k = 10.0f;
        float arg_left = k * (current_frame - (mu - w));
        float arg_right = -k * (current_frame - (mu + w));
        float left = 1.0f / (1.0f + exp(-arg_left));
        float right = 1.0f / (1.0f + exp(-arg_right));
        opacity_multiplier = saturate(left * right);

        if (current_frame < (mu - w) || current_frame > (mu + w))
        {
            opacity_multiplier = 0.0f;
        }
    }
    
    // 2. Interpolate XYZ
    uint k_xyz = uint(current_frame) / max(1u, xyz_stride);
    float alpha_xyz = frac(current_frame / float(max(1u, xyz_stride)));
    uint k_xyz_0 = 0;
    uint k_xyz_1 = 0;
    if (num_xyz_banks > 1u) {
        k_xyz_0 = min(k_xyz, num_xyz_banks - 2u);
        k_xyz_1 = k_xyz_0 + 1u;
    }
    float3 p0 = xyz_bank[i * num_xyz_banks + k_xyz_0];
    float3 p1 = xyz_bank[i * num_xyz_banks + k_xyz_1];
    float3 p_interp = lerp(p0, p1, alpha_xyz);
    
    // Pack Position (Z+ forward, X+ right, Y- up -> X+ forward, Y+ right, Z+ up)
    float3 p_ue = float3(p_interp.z, p_interp.x, -p_interp.y);
    // Match FPackedPos quantization exactly: unpack_pos() does
    // pos_cm = packed_unorm * pos_scale_cm + pos_min_cm.
    float3 p_cm = p_ue * 100.0f;
    float x_q = (p_cm.x - pos_min_cm.x) / max(pos_scale_cm.x, 1e-8f);
    float y_q = (p_cm.y - pos_min_cm.y) / max(pos_scale_cm.y, 1e-8f);
    float z_q = (p_cm.z - pos_min_cm.z) / max(pos_scale_cm.z, 1e-8f);
    uint pack_p = (uint(round(saturate(z_q / 1023.0f) * 1023.0f)) << 22) |
                  (uint(round(saturate(y_q / 2047.0f) * 2047.0f)) << 11) |
                  uint(round(saturate(x_q / 2047.0f) * 2047.0f));
    out_positions[i] = pack_p;

    // 3. Interpolate Rotation & Scale
    uint k_rot = uint(current_frame) / max(1u, rot_stride);
    float alpha_rot = frac(current_frame / float(max(1u, rot_stride)));
    uint k_rot_0 = 0;
    uint k_rot_1 = 0;
    if (num_rot_banks > 1u) {
        k_rot_0 = min(k_rot, num_rot_banks - 2u);
        k_rot_1 = k_rot_0 + 1u;
    }
    float4 r0 = rot_bank[i * num_rot_banks + k_rot_0];
    float4 r1 = rot_bank[i * num_rot_banks + k_rot_1];
    float4 r_interp = normalize(lerp(r0, r1, alpha_rot)); // Cheap Nlerp
    
    // Swapping handedness for rotation (same as C++ convert_splat)
    float qx = -r_interp.z;
    float qy = -r_interp.x;
    float qz = r_interp.y;
    float qw = r_interp.w;
    // ... normalize q ...
    
    // Compute Covariance Sigma = R * S * S^T * R^T
    float3 s = scales[i] * 100.0f; // CM
    // Construct R matrix
    float3x3 R;
    R[0][0] = 1.0f - 2.0f * (qy * qy + qz * qz);
    R[0][1] = 2.0f * (qx * qy - qz * qw);
    R[0][2] = 2.0f * (qx * qz + qy * qw);
    R[1][0] = 2.0f * (qx * qy + qz * qw);
    R[1][1] = 1.0f - 2.0f * (qx * qx + qz * qz);
    R[1][2] = 2.0f * (qy * qz - qx * qw);
    R[2][0] = 2.0f * (qx * qz - qy * qw);
    R[2][1] = 2.0f * (qy * qz + qx * qw);
    R[2][2] = 1.0f - 2.0f * (qx * qx + qy * qy);
    
    float3x3 S = float3x3(s.x, 0, 0, 0, s.y, 0, 0, 0, s.z);
    float3x3 RS = mul(R, S);
    float3x3 Sigma = mul(RS, transpose(RS));
    
    // Pack Covariance
    uint xx = to_custom_float(Sigma[0][0], 0, 5, 5);
    uint xy = to_custom_float(Sigma[0][1], 1, 5, 5);
    uint xz = to_custom_float(Sigma[0][2], 1, 5, 5);
    uint yy = to_custom_float(Sigma[1][1], 0, 5, 5);
    uint yz = to_custom_float(Sigma[1][2], 1, 5, 5);
    uint zz = to_custom_float(Sigma[2][2], 0, 5, 6);
    
    out_covariances[i] = uint2( (yy << 22) | (yz << 11) | zz, (xx << 22) | (xy << 11) | xz ); // High/Low 32 bit split
    
    // 4. Color and opacity
    float4 base_color = saturate(base_colors[i]);
    float3 rgb = base_color.rgb;
    if (num_dc_banks > 0u)
    {
        uint k_dc = uint(current_frame) / max(1u, dc_stride);
        float alpha_dc = frac(current_frame / float(max(1u, dc_stride)));
        uint k_dc_0 = 0;
        uint k_dc_1 = 0;
        if (num_dc_banks > 1u)
        {
            k_dc_0 = min(k_dc, num_dc_banks - 2u);
            k_dc_1 = k_dc_0 + 1u;
        }

        float3 dc0 = dc_bank[i * num_dc_banks + k_dc_0];
        float3 dc1 = dc_bank[i * num_dc_banks + k_dc_1];
        float3 dc_interp = lerp(dc0, dc1, alpha_dc);
        rgb = dc_to_linear_rgb(dc_interp);
    }

    float base_alpha = base_color.a;
    out_colors[i] = float4(rgb, base_alpha * opacity_multiplier);
}
